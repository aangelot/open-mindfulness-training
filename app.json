{
  "expo": {
    "name": "Open Mindfulness",
    "slug": "open-mindfulness-training",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omt",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "net.openmindfulness.app",
      "supportsTablet": true
    },
    "android": {
      "package": "net.openmindfulness.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#121417",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4092df",
          "enableRemoteNotifications": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "OpenSans",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/open-sans/300Light/OpenSans_300Light.ttf",
                    "weight": 300
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/open-sans/400Regular/OpenSans_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/open-sans/400Regular_Italic/OpenSans_400Regular_Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/open-sans/600SemiBold/OpenSans_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/open-sans/700Bold/OpenSans_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "node_modules/@expo-google-fonts/open-sans/300Light/OpenSans_300Light.ttf",
              "node_modules/@expo-google-fonts/open-sans/400Regular/OpenSans_400Regular.ttf",
              "node_modules/@expo-google-fonts/open-sans/400Regular_Italic/OpenSans_400Regular_Italic.ttf",
              "node_modules/@expo-google-fonts/open-sans/600SemiBold/OpenSans_600SemiBold.ttf",
              "node_modules/@expo-google-fonts/open-sans/700Bold/OpenSans_700Bold.ttf"
            ]
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "75a100f6-32e2-440d-8693-425cace78118"
      }
    },
    "owner": "anthony_angelot",
    "updates": {
      "url": "https://u.expo.dev/75a100f6-32e2-440d-8693-425cace78118"
    }
  }
}
